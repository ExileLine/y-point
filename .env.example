ENV="环境标识"

DOCS_TITLE="API文档标题"
DOCS_DESCRIPTION="API文档描述"
DOCS_SUMMARY="API文档总结"
DOCS_VERSION="API文档版本"
DOCS_OPENAPI_URL="API文档版本.json地址"
DOCS_ENABLE="是否开始api文档访问"

SECRET_KEY="签署登录JWT密钥(长度64)"

DEBUG=True
RUN_HOST=0.0.0.0
RUN_PORT=7777
WORKER_LOG_STDOUT=False
# 仅容器逐进程健康探针需要；本地留空
WORKER_HEALTH_FILE=
WORKER_LOG_FILE=.logs/worker.log
# worker 单个日志文件上限，默认 50 MiB；超限清理最早内容，保留约 45 MiB 后继续写入
WORKER_LOG_MAX_BYTES=52428800
SENSITIVE_HEADERS=authorization,cookie,set-cookie,x-api-key

# 对话附件容量，单位字节；20 MiB = 20971520
ARTIFACT_UPLOAD_MAX_BYTES=20971520
# 本轮附件提取文本及元数据合计 UTF-8 字节预算，与上传单文件容量独立
ATTACHMENT_CONTEXT_MAX_BYTES=20971520
# 新 Agent/独立 Run 默认值；修改默认值不会覆盖已保存 Agent 或 Run 快照
AGENT_DEFAULT_MODEL_TIMEOUT_SECONDS=120
AGENT_MAX_MODEL_TIMEOUT_SECONDS=3600
AGENT_DEFAULT_TOOL_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_TIMEOUT_SECONDS=3600
AGENT_DEFAULT_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_OUTPUT_TOKENS=65536
# 模型未返回数据时连接失败的有限重试，由 worker 全局读取；0 次为禁用
AGENT_MODEL_CONNECTION_MAX_RETRIES=1
AGENT_MODEL_CONNECTION_RETRY_DELAY_SECONDS=1
# 供应商 timeout_seconds 仍在供应商管理中单独配置，不能忽略其较短请求超时
# 整轮不设总倒计时；每次模型/工具分别计时。旧 RUN_EXECUTION_TIMEOUT_SECONDS 已停用。
# 最大图步数用于防止模型/工具循环，保持 DeepAgents 当前默认值；不是超时秒数
RUNTIME_RECURSION_LIMIT=9999
# MCP HTTP 建连、写入和连接池等待，以及发现、正式调用的独立时限
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_DISCOVERY_TIMEOUT_SECONDS=15
MCP_CALL_TIMEOUT_SECONDS=120
# 知识检索与嵌入请求分别设置；嵌入还受供应商 timeout_seconds 约束
KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=60
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=60
# PDF 原文提取独立于模型加工；worker 须安装 Tesseract 及以下全部语言包
KNOWLEDGE_PDF_OCR_ENABLED=True
KNOWLEDGE_PDF_OCR_COMMAND=tesseract
KNOWLEDGE_PDF_OCR_LANGUAGES=chi_sim+eng
KNOWLEDGE_PDF_OCR_MIN_CONFIDENCE=60
KNOWLEDGE_PDF_OCR_MAX_PAGES=20
KNOWLEDGE_PDF_OCR_DPI=180
# 正式脚本和页面试运行分别计时
SCRIPT_EXECUTION_TIMEOUT_SECONDS=30
SCRIPT_TEST_TIMEOUT_SECONDS=10
SCRIPT_SANDBOX_STORAGE_DIR=.run-private/tool-sandbox
SCRIPT_PACKAGE_PROXY_FILE=sandbox/package_proxy.py
# 正式工具采用 Agent tool_timeout_seconds 和对应分类时限的较小值

ALLOW_ORIGINS=["*"]
ALLOW_CREDENTIALS=False
ALLOW_METHODS=["*"]
ALLOW_HEADERS=["*"]

DB_BACKEND=mysql
SQLITE_DATABASE=y_point.db
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_POSTGRES_DSN=
ARTIFACT_STORAGE_DIR=.run-private/artifacts
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_OWNER_MAX_BYTES=1073741824
ARTIFACT_OWNER_MAX_FILES=1000
ARTIFACT_REQUIRE_MALWARE_SCAN=False
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=y-point/artifacts/
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

MYSQL_HOSTNAME=127.0.0.1
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-password
MYSQL_PORT=3306
MYSQL_DATABASE=database-name

POSTGRESQL_HOSTNAME=127.0.0.1
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=your-password
POSTGRESQL_PORT=15432
POSTGRESQL_DATABASE=database-name

REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PWD=your-password
REDIS_DB=0
DECODE_RESPONSES=True

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_QUEUE="celery队列标识名称"

CREDENTIAL_ENCRYPTION_KEY="加密保存在数据库中的供应商凭据，包括 API Key 和自定义请求头"

# 由 Dockerfile.sandbox 构建，离线部署可通过 docker load 导入；脚本执行时不安装依赖
SCRIPT_SANDBOX_IMAGE=y-point-script-sandbox:1
# 仅依赖准备阶段允许通过受限代理下载 wheel，脚本执行容器始终禁网
SCRIPT_DEPENDENCY_ALLOW_NETWORK=true
# 仅支持无内嵌凭据的 HTTPS/443 包源；源站域名会自动加入允许列表
SCRIPT_DEPENDENCY_INDEX_URL=https://pypi.org/simple
# JSON 数组；包含包源实际使用的下载域名，不支持通配符
SCRIPT_DEPENDENCY_ALLOWED_HOSTS=["pypi.org","files.pythonhosted.org"]
# 离线 wheel 目录，可填绝对路径或项目根目录下的相对路径；完全离线时同时关闭 ALLOW_NETWORK
SCRIPT_DEPENDENCY_WHEELHOUSE=
# API 与 worker 需共享同一环境目录及已固定的 Docker 镜像；不要手动清理仍被版本引用的缓存
SCRIPT_DEPENDENCY_STORAGE_DIR=.run-private/tool-environments
# 单个准备任务总时限，生效范围 10～1800 秒；默认 180 秒
SCRIPT_DEPENDENCY_BUILD_TIMEOUT_SECONDS=180

# M5.1：MCP 连接累计接收字节、发现工具数量和发现结果总字节限额
MCP_RESPONSE_MAX_BYTES=1048576
MCP_DISCOVERY_MAX_TOOLS=128
MCP_DISCOVERY_MAX_BYTES=262144
# 所有 API/worker 共用数据库名额；工具调用满额直接拒绝，准备任务保留 pending
TOOL_CALL_GLOBAL_LIMIT=16
TOOL_CALL_USER_LIMIT=4
TOOL_CALL_RUN_LIMIT=2
TOOL_PREPARATION_GLOBAL_LIMIT=2
TOOL_PREPARATION_USER_LIMIT=1
# 应用存储预算与磁盘余量，不代表操作系统硬磁盘配额；构建开始前预留 512 MiB
TOOL_STORAGE_MAX_BYTES=8589934592
TOOL_STORAGE_MIN_FREE_BYTES=1073741824
# 后台核对周期与资源过期后的宽限时间，单位秒
TOOL_RESOURCE_RECONCILE_SECONDS=60
TOOL_RESOURCE_GRACE_SECONDS=300

# 知识向量后端：默认有界精确余弦；pgvector 须在 PostgreSQL 目标库单独安装验收
KNOWLEDGE_VECTOR_BACKEND=exact

# SSE Cookie：留空时沿用生产/预发布 Secure 默认值；内网 HTTP 部署显式设为 False。
# STREAM_COOKIE_SECURE=False
