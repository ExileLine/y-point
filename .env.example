ENV="环境标识"

DOCS_TITLE="API文档标题"
DOCS_DESCRIPTION="API文档描述"
DOCS_SUMMARY="API文档总结"
DOCS_VERSION="API文档版本"
DOCS_OPENAPI_URL="API文档版本.json地址"
DOCS_ENABLE="是否开始api文档访问"

SECRET_KEY="签署登录JWT密钥(长度64)"

DEBUG=True
RUN_HOST=0.0.0.0
RUN_PORT=7777
WORKER_LOG_FILE=.logs/worker.log
# worker 单个日志文件上限，默认 50 MiB；超限清理最早内容，保留约 45 MiB 后继续写入
WORKER_LOG_MAX_BYTES=52428800
SENSITIVE_HEADERS=authorization,cookie,set-cookie,x-api-key

ALLOW_ORIGINS=["*"]
ALLOW_CREDENTIALS=False
ALLOW_METHODS=["*"]
ALLOW_HEADERS=["*"]

DB_BACKEND=mysql
SQLITE_DATABASE=y_point.db
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_POSTGRES_DSN=
ARTIFACT_STORAGE_DIR=.run-private/artifacts
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_OWNER_MAX_BYTES=1073741824
ARTIFACT_OWNER_MAX_FILES=1000
ARTIFACT_REQUIRE_MALWARE_SCAN=False
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=y-point/artifacts/
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

MYSQL_HOSTNAME=127.0.0.1
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-password
MYSQL_PORT=3306
MYSQL_DATABASE=database-name

POSTGRESQL_HOSTNAME=127.0.0.1
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=your-password
POSTGRESQL_PORT=15432
POSTGRESQL_DATABASE=database-name

REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PWD=your-password
REDIS_DB=0
DECODE_RESPONSES=True

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_QUEUE="celery队列标识名称"

CREDENTIAL_ENCRYPTION_KEY="加密保存在数据库中的供应商凭据，包括 API Key 和自定义请求头"

# 由 Dockerfile.sandbox 构建，离线部署可通过 docker load 导入；脚本执行时不安装依赖
SCRIPT_SANDBOX_IMAGE=y-point-script-sandbox:1
# 仅依赖准备阶段允许通过受限代理下载 wheel，脚本执行容器始终禁网
SCRIPT_DEPENDENCY_ALLOW_NETWORK=true
# 仅支持无内嵌凭据的 HTTPS/443 包源；源站域名会自动加入允许列表
SCRIPT_DEPENDENCY_INDEX_URL=https://pypi.org/simple
# JSON 数组；包含包源实际使用的下载域名，不支持通配符
SCRIPT_DEPENDENCY_ALLOWED_HOSTS=["pypi.org","files.pythonhosted.org"]
# 离线 wheel 目录，可填绝对路径或项目根目录下的相对路径；完全离线时同时关闭 ALLOW_NETWORK
SCRIPT_DEPENDENCY_WHEELHOUSE=
# API 与 worker 需共享同一环境目录及已固定的 Docker 镜像；不要手动清理仍被版本引用的缓存
SCRIPT_DEPENDENCY_STORAGE_DIR=.run-private/tool-environments
# 单个准备任务总时限，生效范围 10～1800 秒；默认 180 秒
SCRIPT_DEPENDENCY_BUILD_TIMEOUT_SECONDS=180
