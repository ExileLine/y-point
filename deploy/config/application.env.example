# 由 scripts/deploy.py init 渲染到私有目录；不要在镜像中加入真实凭据。
ENV={{ENV}}
DEBUG=False
DOCS_ENABLE=False
STREAM_COOKIE_SECURE={{STREAM_COOKIE_SECURE}}
SECRET_KEY={{SECRET_KEY}}
CREDENTIAL_ENCRYPTION_KEY={{CREDENTIAL_ENCRYPTION_KEY}}
DB_BACKEND=postgresql
POSTGRESQL_HOSTNAME=db
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=y_point
POSTGRESQL_DATABASE=y_point
POSTGRESQL_PASSWORD={{DB_PASSWORD}}
CHECKPOINT_BACKEND=postgres
CHECKPOINT_POSTGRES_DSN=postgresql://y_point:{{DB_PASSWORD}}@db:5432/y_point
REDIS_ENABLED=False
ALLOW_ORIGINS=[]
ALLOW_CREDENTIALS=False
WORKER_LOG_STDOUT=True
WORKER_HEALTH_FILE=/tmp/y-point-worker-id
ARTIFACT_STORAGE_DIR={{DATA_DIR}}/artifacts
SCRIPT_DEPENDENCY_STORAGE_DIR={{DATA_DIR}}/tool-environments
SCRIPT_SANDBOX_STORAGE_DIR={{DATA_DIR}}/tool-sandbox
SCRIPT_PACKAGE_PROXY_FILE={{DATA_DIR}}/runtime/package_proxy.py
SCRIPT_SANDBOX_IMAGE=y-point-script-sandbox:1
SCRIPT_DEPENDENCY_ALLOW_NETWORK=True
KNOWLEDGE_PDF_OCR_ENABLED=True
KNOWLEDGE_PDF_OCR_LANGUAGES=chi_sim+eng
KNOWLEDGE_VECTOR_BACKEND=exact
